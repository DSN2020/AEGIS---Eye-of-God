<UserControl x:Class="EternalVoidPanel.BrowserSessionsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="Browsers" Style="{StaticResource PageTitle}"/>
   <TextBlock Text="Your agents’ browser sessions, together in one place." Style="{StaticResource MutedText}"/>
   <TextBlock x:Name="ModeText" Text="Browser sessions start when you resume scanning." Style="{StaticResource MutedText}" Margin="0,8,0,18"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,14">
   <Button Content="Manage accounts" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0" Click="ManageAccounts_Click"/>
   <TextBlock x:Name="SessionCount" Text="No accounts configured" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Sessions" Background="Transparent" BorderThickness="0" Margin="0,0,16,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SessionSelected">
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Account}"/>
     <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,7,0,0"/>
     <TextBlock Text="{Binding Location}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><Button x:Name="RestartButton" Content="Restart session" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0" IsEnabled="False" Click="Restart_Click"/><TextBlock x:Name="SessionTitle" Text="Browser preview" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
     <TextBlock x:Name="SessionDetail" Grid.Row="1" Text="Add an account to see its browser session here." Style="{StaticResource MutedText}" Margin="0,8,0,14"/>
     <Border Grid.Row="2" Background="#101010" CornerRadius="10">
      <Grid><Image x:Name="SessionImage" Stretch="Uniform" Margin="4"/><TextBlock x:Name="EmptyPreview" Text="No browser session selected" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"/></Grid>
     </Border>
     <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="FrameTime" Text="Previews appear once an agent starts verifying slots." Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="Read-only preview · updates as the agent verifies slots." Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
