<UserControl x:Class="EternalVoidPanel.HiveView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <WrapPanel Margin="0,0,0,10">
    <StackPanel Width="170" Margin="0,0,16,0"><TextBlock Text="Minimum planets" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><ComboBox x:Name="Minimum" SelectionChanged="SettingsChanged"/></StackPanel>
    <StackPanel Width="170" Margin="0,0,16,0"><TextBlock Text="Maximum systems wide" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><ComboBox x:Name="Span" SelectionChanged="SettingsChanged"/></StackPanel>
    <Button x:Name="CopyShown" Content="Copy shown hives" Click="CopyAll" VerticalAlignment="Bottom" Margin="0"/>
   </WrapPanel>
   <TextBlock Text="Largest clusters first. Each planet counts in one hive. Filters find hives with a matching member; every member stays visible." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
   <TextBlock Text="Based on recorded human-player coordinates. Areas still being scanned may contain more planets." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,10"/>
   <TextBlock x:Name="Summary" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
   <TextBlock x:Name="Feedback" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
  </StackPanel>
  <Grid>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Cards"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16"><StackPanel>
     <DockPanel><Button DockPanel.Dock="Right" Content="Copy hive" Tag="{Binding CopyText}" Click="CopyHive" Margin="12,0,0,0"/><TextBlock Text="{Binding Location}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Text="{Binding Summary}" Margin="0,8,0,5"/><TextBlock Text="{Binding SystemsText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding Members}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource InputBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6"><StackPanel>
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBox Text="{Binding CoordinatesText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12" Padding="0,7,0,0"/>
     </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <TextBlock x:Name="Empty" Text="No hives match. Lower the minimum, widen the range, or clear your filters." Style="{StaticResource MutedText}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
 </DockPanel>
</UserControl>
