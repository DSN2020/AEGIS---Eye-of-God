<Window x:Class="EternalVoidPanel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EternalVoidPanel" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="EOG" Icon="Assets/eog-geass.ico" Background="{StaticResource SidebarBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{StaticResource TextBrush}" Width="1360" Height="900" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closed="Window_Closed">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="{StaticResource InputBrush}"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CaretBrush" Value="#F2F2F2"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="PasswordBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="StatValue" TargetType="TextBlock"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,6,0,2"/><Setter Property="Foreground" Value="#F2F2F2"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource TintedPanelBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#222222"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="ShellBorder" Background="{StaticResource SidebarBrush}" BorderBrush="#414141" BorderThickness="1" CornerRadius="9">
 <Grid x:Name="ShellContent" SizeChanged="Shell_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.ColumnSpan="2" MouseLeftButtonDown="DragWindow">
   <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center"><Button ToolTip="Show or hide sidebar" Style="{StaticResource GhostButton}" BorderThickness="0" Padding="4" MinHeight="24" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ToggleSidebar"><TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="13"/></Button><TextBlock Text="Eye of God" Foreground="{StaticResource SubTextBrush}" Margin="14,0,0,0" FontSize="12"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" ToolTip="Minimize" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize"/><Button x:Name="MaximizeButton" Content="□" ToolTip="Maximize or restore" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize"/><Button Content="×" ToolTip="Close EOG" Style="{StaticResource WindowCloseButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseApp"/></StackPanel>
  </Grid>
  <Grid x:Name="SidebarPanel" Grid.Row="1" Margin="10,10,10,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Margin="12,4,0,26"><Image Source="Assets/eog-geass.png" Width="28" Height="28" Margin="0,0,10,0"/><TextBlock Text="EOG" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="Workspace" Style="{StaticResource SectionLabel}" Margin="12,0,12,10" FontSize="12"/><Button x:Name="NavLive" Content="Live overview" Tag="overview" Style="{StaticResource NavButtonActive}" Click="Navigate"/><Button x:Name="NavBrowsers" Content="Browsers" Tag="site" Style="{StaticResource NavButton}" Click="Navigate"/><Button x:Name="NavPlayers" Content="Player coordinates" Tag="diagnostics" Style="{StaticResource NavButton}" Click="Navigate"/><TextBlock Text="Manage" Style="{StaticResource SectionLabel}" FontSize="12" Margin="12,26,12,10"/><Button x:Name="NavAccounts" Content="Agents &amp; accounts" Tag="settings" Style="{StaticResource NavButton}" Click="Navigate"/><Button x:Name="NavAutomation" Content="Upgrade bot" Tag="actions" Style="{StaticResource NavButton}" Click="Navigate"/><Button x:Name="NavActivity" Content="Activity" Tag="logs" Style="{StaticResource NavButton}" Click="Navigate"/></StackPanel>
   <Border Grid.Row="2" BorderBrush="#403236" BorderThickness="0,1,0,0" Padding="12,16,12,0"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource BrandBrush}" Margin="0,1,8,0"/><TextBlock Text="Saved as you scan" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Closing EOG keeps scans running.&#10;Pause to stop and retain progress." Style="{StaticResource MutedText}" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="0,0,8,8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource SubTextBrush}"/><TextBlock x:Name="WorkspaceTitle" Text="Live overview" FontSize="13" FontWeight="SemiBold"/><Border Margin="16,0,0,0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8,3"><TextBlock x:Name="RunBadge" Text="CONNECTING" FontSize="9" FontWeight="SemiBold"/></Border></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="ResumeButton" Content="▶  Resume scan" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Resume_Click"/><Button x:Name="PauseButton" Content="Ⅱ  Pause scan" Margin="0" Click="Pause_Click"/></StackPanel></Grid></Border>
    <Grid Grid.Row="1" Margin="26,24,26,12">
    <Grid x:Name="LiveView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Live overview" Style="{StaticResource PageTitle}"/><TextBlock Text="Every agent, every confirmed slot. Updates automatically." Style="{StaticResource MutedText}" Margin="0,0,0,5"/><TextBlock x:Name="BrowserNote" Text="Checking browser sessions" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,18"/></StackPanel>
     <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-12,18">
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="AGENTS SCANNING" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock x:Name="AgentStat" Text="—" Style="{StaticResource StatValue}"/><TextBlock x:Name="AgentNote" Text="Checking accounts" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="VERIFIED SLOTS" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock x:Name="SlotStat" Text="—" Style="{StaticResource StatValue}"/><TextBlock x:Name="SlotNote" Text="of 94,311 across 9 galaxies" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PLAYERS FOUND" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock x:Name="PlayerStat" Text="—" Style="{StaticResource StatValue}"/><TextBlock x:Name="CoordinateNote" Text="Confirmed coordinates" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="SYSTEMS VERIFIED" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock x:Name="SystemStat" Text="—" Style="{StaticResource StatValue}"/><TextBlock x:Name="SystemNote" Text="All required positions checked per system" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></Border>
     </UniformGrid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="Active agents" FontSize="16" FontWeight="SemiBold"/><Button Content="Restart selected" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0" Click="Restart_Click"/></DockPanel>
       <ListBox x:Name="WorkerList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="WorkerSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel><Grid><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateColor}" FontSize="11" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding Detail}" Foreground="#B5B5B5" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="{Binding Summary}" Foreground="#707070" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
       <Border Grid.Row="2" Background="{StaticResource TintedPanelBrush}" CornerRadius="7" Padding="12" Margin="0,8,0,0"><TextBlock x:Name="ScopeNote" Text="Coverage uses individual slot checks. Earlier findings stay in the directory while all systems are verified." TextWrapping="Wrap" Foreground="#BCAEB1" FontSize="11"/></Border>
      </Grid>
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="PreviewTitle" Text="Agent live view" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid Grid.Row="1" Background="#090909"><Image x:Name="PreviewImage" Stretch="Uniform"/><TextBlock x:Name="PreviewEmpty" Text="Select an agent to see its latest game view.&#10;&#10;Frames appear after login, when slot verification starts." TextWrapping="Wrap" Foreground="#707070" Margin="22" VerticalAlignment="Center" TextAlignment="Center"/></Grid><TextBlock x:Name="PreviewTime" Grid.Row="2" Text="Screenshots update during scanning" Style="{StaticResource MutedText}" FontSize="10" Margin="0,9,0,0"/></Grid></Border>
     </Grid>
    </Grid>
    <Grid x:Name="PlayersView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Player coordinates" Style="{StaticResource PageTitle}"/><TextBlock Text="Confirmed owners, grouped coordinates, and the latest recorded alliance." Style="{StaticResource MutedText}" Margin="0,0,0,20"/></StackPanel>
     <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Search player name" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><TextBox x:Name="PlayerSearch" TextChanged="FilterChanged" ToolTip="Search any part of a player's name"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Filter by alliance" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><TextBox x:Name="AllianceSearch" TextChanged="FilterChanged" ToolTip="Enter an alliance name, or Not recorded"/></StackPanel><Button Grid.Column="2" Content="Clear filters" VerticalAlignment="Bottom" Margin="0" Click="ClearFilters"/></Grid>
     <StackPanel Grid.Row="2"><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button x:Name="DirectoryButton" Content="Players" Click="ShowDirectory"/><Button x:Name="HivesButton" Content="Hives" Click="ShowHives"/></StackPanel><DockPanel x:Name="PlayerResults" Margin="0,0,0,12"><TextBlock x:Name="ResultsCount" Text="Loading players…" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/><Button x:Name="CopyShownButton" Content="Copy shown list" ToolTip="Copy all filtered players, including those below, in Discord format" IsEnabled="False" HorizontalAlignment="Right" Margin="0" Click="CopyMatching"/></DockPanel></StackPanel>
     <Grid x:Name="PlayerDirectory" Grid.Row="3"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PlayerCards"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16"><StackPanel><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><Border Background="#282828" CornerRadius="5" Padding="8,3" Margin="12,0,0,0"><TextBlock Text="{Binding AllianceLabel}" FontSize="11" Foreground="#B7C4EE"/></Border></StackPanel><Button Content="Copy" ToolTip="Copy this player in Discord format" Tag="{Binding CopyText}" Click="CopyPlayer" HorizontalAlignment="Right" Margin="0" Padding="10,4"/></Grid><TextBlock Text="{Binding CountLabel}" Foreground="#777777" FontSize="11" Margin="0,7,0,7"/><TextBox Text="{Binding CoordinatesText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="{StaticResource BgBrush}" FontFamily="Consolas" FontSize="13" Padding="10"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="NoPlayers" Text="No matching players. Try a different name or alliance." Foreground="{StaticResource SubTextBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
     <local:HiveView x:Name="Hives" Grid.Row="3" Visibility="Collapsed"/>
    </Grid>
    <Grid x:Name="AccountsView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="AccountsScroll" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Agents &amp; accounts" Style="{StaticResource PageTitle}"/><TextBlock Text="Choose up to 10 agents and provide one unique account for each." Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
     <Border x:Name="WelcomeCard" Visibility="Collapsed" Background="{StaticResource TintedPanelBrush}" BorderBrush="#4D3D41" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18"><StackPanel><TextBlock Text="Welcome to EOG" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="1. Enter your Eternal Void username and password in Agent 1.&#10;2. Select Save &amp; apply.&#10;3. Select Resume scan at the top when you're ready." TextWrapping="Wrap" Foreground="#D9CBCD" Margin="0,8,0,0"/><TextBlock Text="Your account details and scan progress stay on this Windows account." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Parallel agents" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="The first accounts below are used. Up to nine galaxies scan at once; additional agents wait for work." Style="{StaticResource MutedText}" Margin="0,6,16,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="−" Width="36" Margin="0" Click="LessAgents"/><TextBlock x:Name="AgentCount" Text="4" FontSize="23" FontWeight="SemiBold" Width="55" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Width="36" Margin="0" Click="MoreAgents"/></StackPanel></Grid></Border>
     <TextBlock x:Name="CountChangeStatus" Text="Choose your agent count, enter each account, then select Save &amp; apply." Style="{StaticResource MutedText}" Margin="0,0,0,18"/>
     <Grid Margin="14,0,14,8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="AGENT" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Grid.Column="1" Text="USERNAME" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Grid.Column="2" Text="PASSWORD" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Grid.Column="3" Text="CREDENTIALS" Style="{StaticResource MutedText}" FontSize="10"/></Grid>
     <StackPanel x:Name="AccountRows"/><TextBlock Text="Leave a password blank to retain its saved value. Passwords are encrypted for your Windows account and never shown in logs." Style="{StaticResource MutedText}" Margin="0,10,0,18"/>
    </StackPanel></ScrollViewer><Border Grid.Row="1" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,12,14,4" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="ApplyButton" Content="Save &amp; apply" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/><TextBlock Text="Save your account details, then select Resume scan." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="6,0,0,8"/></StackPanel></Border></Grid>
    <browsing:BrowserWorkspace xmlns:browsing="clr-namespace:EternalVoidPanel.Browsing" x:Name="Browsers" Visibility="Collapsed"/>
    <local:AutomationView x:Name="Automation" Visibility="Collapsed"/>
    <Grid x:Name="ActivityView" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Activity" Style="{StaticResource PageTitle}"/><TextBlock Text="Newest messages first. Each account has its own color; new messages fade to gray over one second." Style="{StaticResource MutedText}" Margin="0,0,0,18"/></StackPanel>
     <ListBox x:Name="ActivityList" Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Border Background="{Binding HighlightBackground}" BorderBrush="{Binding HighlightBorder}" BorderThickness="3,0,0,0" CornerRadius="4" Padding="8,5">
        <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Account}" Foreground="{Binding HighlightForeground}" FontWeight="SemiBold" FontSize="12" Margin="0,0,14,0"/><TextBlock Text="{Binding TimeLabel}" Foreground="#929292" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/></StackPanel>
         <TextBox Text="{Binding Text,Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#DDDDDD" BorderThickness="0" Padding="0" Margin="0,3,0,0" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="#292929" BorderThickness="0,1,0,0" Padding="18,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Connecting to the scanner…" Foreground="{StaticResource SubTextBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="UpdatedText" Grid.Column="1" Text="Local desktop application" Margin="16,0,0,0" Foreground="#777777" FontSize="10.5"/></Grid></Border>
   </Grid>
  </Border>
 </Grid></Border>
</Window>
